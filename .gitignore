# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Fuzzing: dev-only libFuzzer targets, seed corpus growth, and crash finds
# (run locally via tool/fuzz.sh; build output already covered by /build/).
/test/fuzz/
crash-*
leak-*
timeout-*
oom-*

# Agent skill packs installed locally via `npx skills`/`skillfish` (developer
# tooling, not part of this package). Each installer drops a skills/ tree and a
# lockfile into the repo root; keep them out of version control.
/.agents/
/agent/
/.claude/skills/
/.commandcode/skills/
/skills-lock.json

# Local `nitrogen link` artifacts: symlinks into the example app's ephemeral
# Flutter SwiftPM package. Machine-specific and dangling until `flutter pub get`
# runs in example/; never part of the published package (nitro tracks none).
ios/FlutterFramework
macos/FlutterFramework
# blackbox A/B baseline export (run.sh --base), rebuilt per run
benchmark/blackbox/base/
